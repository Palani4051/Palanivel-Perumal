{%- liquid
  case section.settings.image_ratio
    when 'portrait'
      assign ratio = '4 / 5'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      assign ratio = '1 / 1'
  endcase

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
-%}

{% style %}
  #hotspot-{{ section.id }} {
    --hs-gap: {{ section.settings.gap }}px;
    --hs-cols-d: {{ section.settings.columns_desktop }};
    --hs-cols-m: {{ section.settings.columns_mobile }};
    --hs-ratio: {{ ratio }};
    max-width: 1500px;
    margin: 0 auto;
    box-sizing: border-box;
  }
  #hotspot-{{ section.id }} *,
  #hotspot-{{ section.id }} *::before,
  #hotspot-{{ section.id }} *::after { box-sizing: border-box; }

  #hotspot-{{ section.id }} .hs-heading {
    margin: 0 0 clamp(14px, 2vw, 20px);
  }

  /* ---------- Grid ---------- */
  #hotspot-{{ section.id }} .hs-grid {
    display: grid;
    grid-template-columns: repeat(var(--hs-cols-m), minmax(0, 1fr));
    gap: var(--hs-gap);
  }
  @media screen and (min-width: 750px) {
    #hotspot-{{ section.id }} .hs-grid {
      grid-template-columns: repeat(var(--hs-cols-d), minmax(0, 1fr));
    }
  }

  #hotspot-{{ section.id }} .hs-item {
    position: relative;
    margin: 0;
    aspect-ratio: var(--hs-ratio);
    overflow: hidden;
    background: #f3f3f3;
  }
  #hotspot-{{ section.id }} .hs-item img,
  #hotspot-{{ section.id }} .hs-item svg.hs-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ---------- Hotspot (+) ---------- */
  #hotspot-{{ section.id }} .hs-dot {
    position: absolute;
    z-index: 2;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: #000;
    display: grid;
    place-items: center;
    cursor: pointer;
    transform: translate(-50%, -50%);
    box-shadow: 0 1px 5px rgba(0, 0, 0, 0.3);
    transition: transform 0.2s ease;
  }
  #hotspot-{{ section.id }} .hs-dot::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.7);
    animation: hs-pulse-{{ section.id }} 2s ease-out infinite;
    z-index: -1;
  }
  /* bigger tap target for touch */
  #hotspot-{{ section.id }} .hs-dot::after {
    content: "";
    position: absolute;
    inset: -10px;
  }
  #hotspot-{{ section.id }} .hs-dot:hover,
  #hotspot-{{ section.id }} .hs-dot:focus-visible {
    transform: translate(-50%, -50%) scale(1.15);
  }
  #hotspot-{{ section.id }} .hs-dot svg { width: 10px; height: 10px; }

  @keyframes hs-pulse-{{ section.id }} {
    0%   { transform: scale(1);   opacity: 0.9; }
    100% { transform: scale(2.2); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    #hotspot-{{ section.id }} .hs-dot::before { animation: none; }
  }

  /* ---------- Modal ---------- */
  #hotspot-{{ section.id }} .hs-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  #hotspot-{{ section.id }} .hs-modal.is-open { display: flex; }

  #hotspot-{{ section.id }} .hs-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    animation: hs-fade 0.2s ease;
  }
  #hotspot-{{ section.id }} .hs-dialog {
    position: relative;
    width: 100%;
    max-width: 445px;
    max-height: calc(100vh - 40px);
    max-height: calc(100dvh - 40px);
    overflow-y: auto;
    padding: 20px 32px 32px;
    background: #fff;
    color: #000;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
    animation: hs-pop 0.25s ease;
  }
  @keyframes hs-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes hs-pop {
    from { opacity: 0; transform: translateY(12px) scale(0.98); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes hs-slide { from { transform: translateY(100%); } to { transform: none; } }

  #hotspot-{{ section.id }} .hs-close {
    display: block;
    margin: 0 0 4px auto;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  #hotspot-{{ section.id }} .hs-close svg { width: 20px; height: 20px; }

  #hotspot-{{ section.id }} .hs-product {
    display: grid;
    grid-template-columns: 125px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }
  #hotspot-{{ section.id }} .hs-product-img {
    width: 100%;
    aspect-ratio: 5 / 7;
    object-fit: cover;
    display: block;
    background: #f3f3f3;
  }
  #hotspot-{{ section.id }} .hs-title {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.25;
  }
  #hotspot-{{ section.id }} .hs-price {
    margin: 16px 0 12px;
    font-size: 1.25rem;
  }
  #hotspot-{{ section.id }} .hs-price s {
    margin-left: 8px;
    opacity: 0.55;
    font-size: 0.9em;
  }
  #hotspot-{{ section.id }} .hs-desc {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.3;
  }

  /* Options */
  #hotspot-{{ section.id }} .hs-option { margin-top: 22px; }
  #hotspot-{{ section.id }} .hs-label {
    display: block;
    margin-bottom: 8px;
    font-size: 1rem;
  }

  #hotspot-{{ section.id }} .hs-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
  }
  #hotspot-{{ section.id }} .hs-swatch {
    position: relative;
    flex: 1 1 0;
    min-width: 90px;
    margin: 0 -1px -1px 0;
    cursor: pointer;
  }
  #hotspot-{{ section.id }} .hs-swatch input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  #hotspot-{{ section.id }} .hs-swatch span {
    display: block;
    padding: 14px 16px;
    border: 1px solid rgba(0, 0, 0, 0.6);
    font-size: 1.25rem;
    line-height: 1.2;
    text-align: left;
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
  }
  #hotspot-{{ section.id }} .hs-swatch input:checked + span {
    border-color: #000;
    box-shadow: inset 0 0 0 1px #000;
    position: relative;
    z-index: 1;
  }
  #hotspot-{{ section.id }} .hs-swatch input:focus-visible + span {
    outline: 2px solid #000;
    outline-offset: 2px;
  }

  #hotspot-{{ section.id }} .hs-select { position: relative; }
  #hotspot-{{ section.id }} .hs-select select {
    width: 100%;
    height: 56px;
    padding: 0 72px 0 16px;
    border: 1px solid rgba(0, 0, 0, 0.6);
    border-radius: 0;
    background: #fff;
    color: #000;
    font: inherit;
    font-size: 1.125rem;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
  }
  #hotspot-{{ section.id }} .hs-select select:focus-visible {
    outline: 2px solid #000;
    outline-offset: 2px;
  }
  #hotspot-{{ section.id }} .hs-chevron {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 56px;
    display: grid;
    place-items: center;
    border-left: 1px solid rgba(0, 0, 0, 0.6);
    pointer-events: none;
  }
  #hotspot-{{ section.id }} .hs-chevron svg { width: 18px; height: 18px; }

  #hotspot-{{ section.id }} .hs-error {
    min-height: 1.2em;
    margin: 14px 0 0;
    color: #b00020;
    font-size: 0.875rem;
  }

  #hotspot-{{ section.id }} .hs-add {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    width: 100%;
    margin-top: 16px;
    padding: 20px 16px;
    border: 0;
    border-radius: 0;
    background: #000;
    color: #fff;
    font: inherit;
    font-size: 1.25rem;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  #hotspot-{{ section.id }} .hs-add:hover { opacity: 0.85; }
  #hotspot-{{ section.id }} .hs-add:disabled { opacity: 0.45; cursor: not-allowed; }
  #hotspot-{{ section.id }} .hs-add svg { width: 40px; height: 12px; flex-shrink: 0; }

  /* ---------- Mobile: bottom sheet ---------- */
  @media screen and (max-width: 749px) {
    #hotspot-{{ section.id }} .hs-modal { align-items: flex-end; padding: 0; }
    #hotspot-{{ section.id }} .hs-dialog {
      max-width: 100%;
      max-height: 90vh;
      max-height: 90dvh;
      padding: 12px 20px calc(24px + env(safe-area-inset-bottom, 0px));
      border-radius: 16px 16px 0 0;
      animation: hs-slide 0.3s ease;
    }
    #hotspot-{{ section.id }} .hs-product { grid-template-columns: 105px minmax(0, 1fr); gap: 16px; }
    #hotspot-{{ section.id }} .hs-title { font-size: 1.125rem; }
    #hotspot-{{ section.id }} .hs-price { font-size: 1.0625rem; margin: 10px 0 8px; }
    #hotspot-{{ section.id }} .hs-desc { font-size: 0.875rem; }
    #hotspot-{{ section.id }} .hs-swatch span { font-size: 1.0625rem; padding: 12px 14px; }
    #hotspot-{{ section.id }} .hs-select select { height: 50px; font-size: 1rem; }
    #hotspot-{{ section.id }} .hs-chevron { width: 50px; }
    #hotspot-{{ section.id }} .hs-add { font-size: 1.0625rem; padding: 18px 16px; }
  }
{% endstyle %}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<section
  id="hotspot-{{ section.id }}"
  class="
    hs-section spacing-style    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
  "
  data-go-to-cart="false"
  data-cart-url="{{ routes.cart_url }}"
  data-add-url="{{ routes.cart_add_url }}.js"
  data-cart-js-url="{{ routes.cart_url }}.js"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- if section.settings.heading != blank -%}
    <h3 class="hs-heading">{{ section.settings.heading }}</h3>
  {%- endif -%}

  <div class="hs-grid">
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}
      <figure class="hs-item" {{ block.shopify_attributes }}>
        {%- liquid
          assign grid_image = block.settings.image
          if grid_image == blank and product != blank
            assign grid_image = product.featured_image
          endif
        -%}
        {%- if grid_image != blank -%}
          {%- assign grid_alt = grid_image.alt | default: product.title -%}
          {{
            grid_image
            | image_url: width: 1000
            | image_tag:
              widths: '400, 600, 800, 1000',
              sizes: '(min-width: 750px) calc(100vw / var(--hs-cols-d)), 50vw',
              loading: 'lazy',
              alt: grid_alt
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'hs-placeholder' }}
        {%- endif -%}

        {%- if product != blank -%}
          <button
            type="button"
            class="hs-dot"
            style="left: {{ block.settings.hotspot_x }}%; top: {{ block.settings.hotspot_y }}%;"
            data-open="{{ block.id }}"
            aria-haspopup="dialog"
            aria-label="{{ product.title | escape }}"
          >
            <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
              <path d="M5 0v10M0 5h10"/>
            </svg>
          </button>
        {%- endif -%}
      </figure>
    {%- endfor -%}
  </div>

  {%- comment -%} Popups {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- assign product = block.settings.product -%}
    {%- if product != blank -%}
      {%- assign current = product.variants | where: 'available' | first -%}
      {%- unless current -%}
        {%- assign current = product.variants.first -%}
      {%- endunless -%}
      <div
        class="hs-modal"
        data-modal="{{ block.id }}"
        data-add-label=" {{ 'products.product.add_to_cart' | t }}"
        data-soldout-label="{{ 'products.product.sold_out' | t }}"
        data-added-label="{{ 'products.product.added' | t }}"
        aria-hidden="true"
      >
        <div class="hs-backdrop" data-close></div>
        <div
          class="hs-dialog"
          role="dialog"
          aria-modal="true"
          aria-labelledby="hs-title-{{ block.id }}"
        >
          <button type="button" class="hs-close" data-close aria-label="Close">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M2 2l16 16M18 2L2 18"/>
            </svg>
          </button>

          <div class="hs-product">
            {%- if product.featured_image -%}
              {{
                product.featured_image
                | image_url: width: 400
                | image_tag: class: 'hs-product-img', loading: 'lazy', alt: product.featured_image.alt
              }}
            {%- else -%}
              <div class="hs-product-img"></div>
            {%- endif -%}

            <div>
              <h3 class="hs-title" id="hs-title-{{ block.id }}">{{ product.title }}</h3>
              <p class="hs-price" data-price>
                {{ current.price | money }}
                {%- if current.compare_at_price > current.price -%}
                  <s>{{ current.compare_at_price | money }}</s>
                {%- endif -%}
              </p>
              <p class="hs-desc">{{ product.description | strip_html | truncatewords: 22 }}</p>
            </div>
          </div>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign idx = forloop.index0 -%}
              {%- assign opt_name = option.name | downcase -%}
              {%- assign selected_val = current.options[idx] -%}
              <div class="hs-option" data-option="{{ idx }}" data-name="{{ option.name | escape }}">
                <span class="hs-label" id="hs-lbl-{{ block.id }}-{{ idx }}">{{ option.name }}</span>

                {%- if opt_name contains 'color' or opt_name contains 'colour' -%}
                  <div class="hs-swatches" role="radiogroup" aria-labelledby="hs-lbl-{{ block.id }}-{{ idx }}">
                    {%- for value in option.values -%}
                      <label class="hs-swatch">
                        <input
                          type="radio"
                          name="hs-{{ block.id }}-{{ idx }}"
                          value="{{ value | escape }}"
                          {% if value == selected_val %}
                            checked
                          {% endif %}
                        >
                        <span>{{ value }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <div class="hs-select">
                    <select aria-labelledby="hs-lbl-{{ block.id }}-{{ idx }}">
                      {%- for value in option.values -%}
                        <option
                          value="{{ value | escape }}"
                          {% if value == selected_val %}
                            selected
                          {% endif %}
                        >
                          {{ value }}
                        </option>
                      {%- endfor -%}
                    </select>
                    <span class="hs-chevron" aria-hidden="true">
                      <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6">
                        <path d="M2 6l7 7 7-7"/>
                      </svg>
                    </span>
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <p class="hs-error" role="alert" data-error></p>

          <button
            type="button"
            class="hs-add"
            data-add
            {% unless current.available %}
              disabled
            {% endunless %}
          >
            <span data-add-text>
              {%- if current.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </span>
            <svg viewBox="0 0 40 12" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
              <path d="M0 6h38M32 1l6 5-6 5"/>
            </svg>
          </button>

          <script type="application/json" data-variants>
            [
              {%- for variant in product.variants -%}
                {%- assign compare = '' -%}
                {%- if variant.compare_at_price > variant.price -%}
                  {%- assign compare = variant.compare_at_price | money -%}
                {%- endif -%}
                {%- assign vimg = '' -%}
                {%- if variant.featured_image -%}
                  {%- assign vimg = variant.featured_image | image_url: width: 400 -%}
                {%- endif -%}
                {
                  "id": {{ variant.id }},
                  "options": {{ variant.options | json }},
                  "available": {{ variant.available | json }},
                  "price": {{ variant.price | money | json }},
                  "compare": {{ compare | json }},
                  "image": {{ vimg | json }}
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          </script>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
</section>

<script src="{{ 'hotspot-section.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:names.Hotspot",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:settings.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:settings.mobile_columns",
      "options": [
        { "value": "1", "label": "t:options.one" },
        { "value": "2", "label": "t:options.two" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "t:options.square" },
        { "value": "portrait", "label": "t:options.portrait" },
        { "value": "landscape", "label": "t:options.landscape" }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 90
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "hotspot_image",
      "name": "t:names.hotspot_image",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image",
          "info": "t:info.hotspot_image_info"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:settings.product"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "t:settings.x_position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "t:settings.y_position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.Hotspot",
      "blocks": [
        { "type": "hotspot_image" },
        { "type": "hotspot_image" },
        { "type": "hotspot_image" },
        { "type": "hotspot_image" },
        { "type": "hotspot_image" },
        { "type": "hotspot_image" }
      ]
    }
  ]
}
{% endschema %}
